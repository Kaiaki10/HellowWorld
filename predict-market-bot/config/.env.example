# ============================================================
# API Keys - Copy to .env and fill in your values
# ============================================================

# Polymarket
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_WALLET_PRIVATE_KEY=your_wallet_private_key

# Kalshi
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret

# AI Models
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Social Media Scraping
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Sports Data (optional - free tier: 500 requests/month)
ODDS_API_KEY=your_odds_api_key

# Economic Data (free - 120 requests/min, get key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key

# Optional
DISCORD_WEBHOOK_URL=your_discord_webhook_for_alerts
